{
  "Gateway": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Enabled": true,
    "Issuer": "https://identity-dev.emcore.platform",
    "Audience": "https://api-dev.emcore.platform",
    "JwksUrl": "http://localhost:5001/.well-known/jwks.json",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-access-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      }
    }
  }
}