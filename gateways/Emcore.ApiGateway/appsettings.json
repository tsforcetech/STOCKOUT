        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": { "Path": "/swagger/services/portal-bff/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-mcp-gateway": {
