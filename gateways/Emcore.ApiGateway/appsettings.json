{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ],
    "ForwardedHeadersEnabled": true,
    "TrustedProxies": [ "127.0.0.1", "::1" ],
    "TrustedNetworks": [],
    "ForwardLimit": 1,
    "RequestTimeoutSeconds": 30,
    "MaxRequestBodySizeBytes": 10485760
  },
  "RateLimiting": {
    "Anonymous": { "PermitLimit": 60 },
    "Authenticated": { "PermitLimit": 300 },
    "LoginOtp": { "PermitLimit": 10 }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-access-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "LoginOtpPolicy",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity-access-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "user-organization-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "organizations-route": {
        "ClusterId": "user-organization-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/organizations/{**catch-all}"
        }
      },
      "public-bff-route": {
        "ClusterId": "public-bff-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": {
          "Path": "/api/v1/public/{**catch-all}"
        }
      },
      "portal-bff-route": {
        "ClusterId": "portal-bff-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/portal/{**catch-all}"
        }
      },
      "mcp-gateway-route": {
        "ClusterId": "mcp-gateway-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/mcp/{**catch-all}"
        }
      },
      "realtime-gateway-route": {
        "ClusterId": "realtime-gateway-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/realtime/{**catch-all}"
        }
      },
      "catalog-listing-route": {
        "ClusterId": "catalog-listing-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      },
      "inventory-media-route": {
        "ClusterId": "inventory-media-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}"
        }
      },
      "search-discovery-route": {
        "ClusterId": "search-discovery-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": {
          "Path": "/api/v1/search/{**catch-all}"
        }
      },
      "bidding-deal-route": {
        "ClusterId": "bidding-deal-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/deals/{**catch-all}"
        }
      },
      "inspection-trust-route": {
        "ClusterId": "inspection-trust-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/inspections/{**catch-all}"
        }
      },
      "subscription-payment-route": {
        "ClusterId": "subscription-payment-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        }
      },
      "conversation-realtime-route": {
        "ClusterId": "conversation-realtime-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/messages/{**catch-all}"
        }
      },
      "notification-integration-route": {
        "ClusterId": "notification-integration-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": {
          "Path": "/api/v1/webhooks/{**catch-all}"
        }
      },
      "workflow-scheduler-route": {
        "ClusterId": "workflow-scheduler-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/workflows/{**catch-all}"
