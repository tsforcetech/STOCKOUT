        "Match": { "Path": "/swagger/services/mcp-gateway/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-realtime-gateway": {
        "ClusterId": "realtime-gateway-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": { "Path": "/swagger/services/realtime-gateway/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-identity-access": {
        "ClusterId": "identity-access-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": { "Path": "/swagger/services/identity-access/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
