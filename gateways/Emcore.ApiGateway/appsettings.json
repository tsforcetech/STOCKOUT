{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ],
    "ForwardedHeadersEnabled": true,
    "TrustedProxies": [ "127.0.0.1", "::1" ],
    "TrustedNetworks": [],
    "ForwardLimit": 1,
    "RequestTimeoutSeconds": 30,
    "MaxRequestBodySizeBytes": 10485760
  },
  "RateLimiting": {
    "Anonymous": { "PermitLimit": 60 },
    "Authenticated": { "PermitLimit": 300 },
    "LoginOtp": { "PermitLimit": 10 }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "LoginOtpPolicy",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "organization-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "organizations-route": {
        "ClusterId": "organization-cluster",
        "AuthorizationPolicy": "AuthenticatedRoutePolicy",
        "RateLimiterPolicy": "AuthenticatedPolicy",
        "Match": {
          "Path": "/api/v1/organizations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5101/"
          }
        }
      },
      "organization-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5102/"
          }
        }
      }
    }
  }
}
