        "Match": { "Path": "/swagger/services/search-discovery/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-bidding-deal": {
        "ClusterId": "bidding-deal-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": { "Path": "/swagger/services/bidding-deal/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-inspection-trust": {
        "ClusterId": "inspection-trust-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": { "Path": "/swagger/services/inspection-trust/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-subscription-payment": {
        "ClusterId": "subscription-payment-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": { "Path": "/swagger/services/subscription-payment/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-conversation-realtime": {
        "ClusterId": "conversation-realtime-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": { "Path": "/swagger/services/conversation-realtime/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-notification-integration": {
        "ClusterId": "notification-integration-cluster",
        "AuthorizationPolicy": "PublicPolicy",
        "RateLimiterPolicy": "AnonymousPolicy",
        "Match": { "Path": "/swagger/services/notification-integration/v1/openapi.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "swagger-workflow-scheduler": {
        "ClusterId": "workflow-scheduler-cluster",
        "AuthorizationPolicy": "PublicPolicy",
