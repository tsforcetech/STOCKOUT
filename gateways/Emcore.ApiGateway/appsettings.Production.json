{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "AllowedOrigins": [],
    "ForwardedHeadersEnabled": true,
    "TrustedProxies": [ "127.0.0.1", "::1" ],
    "TrustedNetworks": [],
    "ForwardLimit": 1,
    "RequestTimeoutSeconds": 30,
    "MaxRequestBodySizeBytes": 10485760
  },
  "Authentication": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": ""
  },
  "RateLimiting": {
    "Anonymous": { "PermitLimit": 60 },
    "Authenticated": { "PermitLimit": 300 },
    "LoginOtp": { "PermitLimit": 10 }
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5101/"
          }
        }
      },
      "organization-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5102/"
          }
        }
      }
    }
  }
}
