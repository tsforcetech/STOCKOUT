{
  "Gateway": {
    "AllowedOrigins": [
      "https://stockout.emcore.platform",
      "https://admin.emcore.platform"
    ]
  },
  "Jwt": {
    "Enabled": true,
    "Issuer": "https://identity.emcore.platform",
    "Audience": "https://api.emcore.platform",
    "JwksUrl": "https://identity-access-api/.well-known/jwks.json",
    "RequireHttpsMetadata": true
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-access-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-access-api"
          }
        }
      }
    }
  }
}